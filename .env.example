# Twitch API (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# TikTok API (https://developers.tiktok.com)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# Meta / Facebook (https://developers.facebook.com)
META_APP_ID=
META_APP_SECRET=

# Instagram (https://developers.facebook.com — Instagram Login)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# YouTube OAuth2 (Google Cloud Console → YouTube Data API v3)
# Place client_secrets.json in project root
# Refresh token is auto-saved to .clipper_token.json after first auth
